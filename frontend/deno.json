{
  "imports": {
    "@/": "./",
    "@zod/zod": "jsr:@zod/zod@^4.4.3"
  },
  "fmt": {
    "exclude": [
      "src/routeTree.gen.ts"
    ]
  },
  "lint": {
    "include": ["src/", "components/", "lib/"],
    "exclude": [
      "src/testdata/",
      "src/fixtures/**/*.ts",
      "src/routeTree.gen.ts"
    ],
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"]
    }
  },
  "allowScripts": ["npm:msw@2.14.5"]
}
